# ============================================================================
# HaloMail — environment template. Copy to .env and fill in.
#   cp .env.example .env
# ============================================================================

# ---- Runtime ----
APP_ENV=development            # development | staging | production
APP_NAME=halomail-api
HTTP_HOST=0.0.0.0
HTTP_PORT=8080                 # ConnectRPC + REST gateway
LOG_LEVEL=debug                # debug | info | warn | error
LOG_FORMAT=text                # text (dev) | json (prod)

# Public base URLs (used in emails, booking links, OAuth callbacks)
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=halomail
POSTGRES_PASSWORD=halomail
POSTGRES_DB=halomail
POSTGRES_SSLMODE=disable
# Full DSN (overrides the parts above if set)
DATABASE_URL=postgres://halomail:halomail@localhost:5432/halomail?sslmode=disable

# ---- Complete PostgreSQL archives in private Cloudflare R2 ----
# Neon is the only database. R2 keeps the latest TWO verified hourly batches.
# Run one worker per prefix. With these four values, the gateway runs it.
# Keep this bucket private: archives contain all customer data and auth hashes.
R2_BACKUP_ENABLED=true
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_BACKUP_PREFIX=halomail/production
R2_BACKUP_INTERVAL=1h
R2_BACKUP_TIMEOUT=15m
R2_BACKUP_MAX_AGE=2h
# Optional direct/unpooled Neon URL for pg_dump; otherwise DATABASE_URL.
BACKUP_DATABASE_URL=
# PostgreSQL clients are included in deploy/Dockerfile.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
# Set only when restoring a chosen backup into a NEW, EMPTY database.
RESTORE_DATABASE_URL=

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
# 32+ byte random secret. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-value-please
# Same random 32+ character value in apps/web/.env (server-to-server OTP delivery).
OTP_DELIVERY_SECRET=
SESSION_TTL=720h               # 30 days
API_KEY_PREFIX=hl_

FREE_FORM_LIMIT=25
FREE_MEETING_LIMIT=10
FREE_LIMITS_MONTHLY=true

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="HaloMail <no-reply@email.zeroaxiis.tech>"
# Local dev uses Mailpit SMTP instead of Resend when RESEND_API_KEY is empty
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- Google Calendar OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/calendar/callback
CALENDAR_ENCRYPTION_KEY=

# ---- Microsoft / Outlook Calendar OAuth ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URL=http://localhost:8080/v1/oauth/microsoft/callback

# ---- Observability (OpenTelemetry) ----
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # Jaeger OTLP/HTTP
OTEL_SERVICE_NAME=halomail-api
OTEL_TRACES_SAMPLER_ARG=1.0

# ---- Rate limiting (defaults; per-route overrides in code) ----
RATELIMIT_PUBLIC_RPS=10
RATELIMIT_PUBLIC_BURST=20
