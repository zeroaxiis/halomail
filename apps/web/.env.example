API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000

# Same random 32+ character secret in the gateway/identity environment.
# Generate with: openssl rand -hex 32. Never use a NEXT_PUBLIC_ prefix.
OTP_DELIVERY_SECRET=

# Resend: verify email.zeroaxiis.tech and use a key allowed to send from it.
RESEND_API_KEY=
EMAIL_FROM="HaloMail <no-reply@email.zeroaxiis.tech>"

# Local Mailpit fallback only when RESEND_API_KEY is empty (development only).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
